# FusionAuth (server-only — never expose the API key)
FUSIONAUTH_URL=
FUSIONAUTH_API_KEY=
FUSIONAUTH_APPLICATION_ID=
FUSIONAUTH_TENANT_ID=
NEXT_PUBLIC_FUSIONAUTH_APPLICATION_ID=

# Signed session cookie
AUTH_SECRET=

# Support form
# Option A (recommended): Gmail App Password — https://myaccount.google.com/apppasswords
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# Option B: RESEND_API_KEY=
# Option C: FormSubmit (no key) — confirm the first activation email in your inbox
